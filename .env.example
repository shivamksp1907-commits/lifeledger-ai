# App secret key for signing JWT tokens (change this in production!)
SECRET_KEY=super-secret-key-change-me

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Gemini configuration (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# SSL Verification (set to false if behind a corporate proxy or antivirus intercepting TLS/SSL)
SSL_VERIFY=true

# OpenAI configuration (if LLM_PROVIDER=openai)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Database URL (optional, defaults to SQLite local file sqlite:///./lifeledger.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/lifeledger
